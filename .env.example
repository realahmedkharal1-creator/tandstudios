# Contact form (pick ONE). Get a free key at https://web3forms.com (enter your email, key arrives by mail)
NEXT_PUBLIC_WEB3FORMS_KEY=
# ...or a Formspree endpoint, e.g. https://formspree.io/f/xxxxxxx
NEXT_PUBLIC_FORMSPREE_URL=
# Set to "true" only if you want sample reviews visible in a production build (not recommended)
NEXT_PUBLIC_SHOW_PLACEHOLDERS=
